# Caddyfile for Family Net
# Auto-TLS via Tailscale (enable in Tailscale admin: Settings → ACLs → HTTPS → Enable HTTPS).
# Cert is served to Caddy via the Tailscale local API on :80. No public DNS or
# Let's Encrypt required.

white-knight.tail0d05f6.ts.net {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000 {
		# Streaming chat responses (SSE) work better with header buffering off
		header_up -X-Forwarded-Proto
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output file /var/log/caddy/family-net.log {
			roll_size 50mb
			roll_keep 5
			roll_keep_for 30d
		}
	}
}
