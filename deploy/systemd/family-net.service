[Unit]
Description=Family Net SvelteKit server
Documentation=https://github.com/example/family-net
After=network-online.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=appuser
Group=appuser
WorkingDirectory=/home/appuser/family-net
EnvironmentFile=/home/appuser/family-net/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env node build/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=mixed

# Hardening — keeps the app in its lane
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/home/appuser/family-net/data
# Build artifacts live in $WORKDIR; allow loading them
ReadOnlyPaths=/home/appuser/family-net/build

StandardOutput=journal
StandardError=journal
SyslogIdentifier=family-net

[Install]
WantedBy=multi-user.target
