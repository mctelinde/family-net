# ── Authentication ──────────────────────────────────────────────────────────
# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# ── Agent API ────────────────────────────────────────────────────────────────
# Bearer token that AI agents use to call /api/notebook. Generate with: openssl rand -hex 24
AGENT_API_KEY=change-me

# ── AI Provider (optional — used for future in-app AI features) ──────────────
# AI_PROVIDER=none          # no AI (default)
# AI_PROVIDER=openai        # OpenAI or any OpenAI-compatible endpoint
# AI_PROVIDER=anthropic     # Anthropic Claude
# AI_PROVIDER=ollama        # Local Ollama instance

# OpenAI / OpenAI-compatible (also used for Ollama with base URL override)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama / LM Studio / vLLM

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Model override (defaults: gpt-4o for openai, claude-opus-4-5 for anthropic, llama3 for ollama)
# AI_MODEL=gpt-4o

# ── Dev tools (optional) ─────────────────────────────────────────────────────
# Exposes read_file, write_file, run_command, and http_request tools to the agent.
# Only enable in trusted local/dev environments — the agent can read and write
# files, run commands, and make HTTP requests within configured bounds.
# ENABLE_DEV_TOOLS=true
# DEV_TOOLS_ROOT=/absolute/path/to/project   # defaults to process.cwd()
# HTTP_TOOL_BASE_URL=http://localhost:5173    # base for relative URLs in http_request
